{
  "name": "ailecha-miniprogram",
  "version": "1.0.0",
  "description": "爱乐查-生活小助手 微信小程序（工程化版）",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" --max-warnings 0",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.{ts,js,json,wxml,wxss}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,json}\"",
    "compress:images": "node scripts/compress-images.js",
    "upload:cdn": "node scripts/upload-cdn.js",
    "docs": "typedoc",
    "ci:upload": "node scripts/ci-upload.js",
    "prepare": "husky install"
  },
  "keywords": [
    "wechat",
    "miniprogram",
    "typescript"
  ],
  "license": "MIT",
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "husky": "^9.1.4",
    "lint-staged": "^15.2.7",
    "miniprogram-api-typings": "^3.12.2",
    "miniprogram-ci": "^1.9.11",
    "prettier": "^3.3.3",
    "typedoc": "^0.26.5",
    "typescript": "^5.5.3"
  },
  "optionalDependencies": {
    "imagemin": "^8.0.1",
    "imagemin-mozjpeg": "^10.0.0",
    "imagemin-pngquant": "^9.0.2"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.{json,wxml,wxss}": [
      "prettier --write"
    ]
  }
}
